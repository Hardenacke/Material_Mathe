{
  "name": "mathe-wettkampf-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "check": "node scripts/pruefen.mjs && node scripts/bundle.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test integration/*.test.mjs",
    "build": "node scripts/bundle.mjs",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "vorschau": "npm run build && node scripts/vorschau.mjs",
    "deploy:check": "npm run check && wrangler deploy --dry-run --outdir .deploy-check",
    "deploy": "npm run check && wrangler deploy",
    "neu": "node scripts/wettkampf-anlegen.mjs",
    "codes": "node scripts/verwaltung.mjs erzeugen",
    "verwaltung": "node scripts/verwaltung.mjs"
  },
  "devDependencies": {"esbuild": "0.28.2", "miniflare": "5.20261023.0-beta", "wrangler": "4.153.0"},
  "dependencies": {"katex": "0.19.1"}
}
