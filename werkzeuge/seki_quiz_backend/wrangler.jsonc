{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathematik-seki-quiz",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {"bindings": [{"name": "ROUNDS", "class_name": "CompetitionRound"}]},
  "exports": {"CompetitionRound": {"type": "durable-object", "storage": "sqlite"}},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mathematik-seki-leaderboard",
    "database_id": "aad4c719-479e-4dcd-879e-6b0acc762bc1",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "ALLOWED_ORIGINS": "https://hardenacke.github.io,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8788,http://localhost:8788"
  },
  "observability": {"enabled": false}
}
